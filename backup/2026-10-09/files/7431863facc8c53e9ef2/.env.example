# Copy this file to `.env` and fill in a key to enable generated answers.
# Without any key the app still works in retrieval-only mode (offline search).

# --- Provider: "groq" (default) or "openai" ---
LLM_PROVIDER=groq

# Groq: free API key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_TEMPERATURE=0
# TOP_K=5
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- OpenAI / OpenAI-compatible (e.g. DeepSeek). Only used when LLM_PROVIDER=openai ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# For DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com  and LLM_MODEL=deepseek-chat
