# Generated outputs (reproducible — run main.py to regenerate)
outputs/predictions/
outputs/results/
models/
out/

# outputs/tables/ is ignored with a single exception below. The pattern must
# exclude the *contents* (trailing /*) rather than the directory itself —
# git will not descend into an excluded directory, so a negation inside one
# would never take effect.
outputs/tables/*
# The thesis \input{}s these tables directly; without them a fresh clone
# cannot compile, so they are tracked even though they are generated.
!outputs/tables/data_quality_table.tex
!outputs/tables/feature_ablation_table.tex

# Figures are kept for README preview
# outputs/figures/ is intentionally tracked

